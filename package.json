{
  "name": "invoice-audit-desk",
  "productName": "发票审核台",
  "version": "1.7.3",
  "description": "发票审核台 - 发票自动识别与审核",
  "main": "main.js",
  "author": "财务部",
  "license": "UNLICENSED",
  "scripts": {
    "vendor": "node scripts/copy-vendor.js",
    "start": "npm run vendor && electron .",
    "dist": "npm run vendor && electron-builder --win --x64",
    "test": "node test/unit.js",
    "test:e2e": "node test/e2e.js"
  },
  "dependencies": {
    "electron-updater": "6.3.9",
    "imapflow": "1.0.164",
    "mailparser": "3.7.1"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "pdfjs-dist": "3.11.174",
    "tesseract.js": "5.1.1",
    "tesseract.js-core": "5.1.1",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "jpeg-js": "0.4.4",
    "playwright-core": "1.48.2",
    "nodemailer": "6.9.15",
    "xlsx": "0.18.5"
  },
  "build": {
    "appId": "cn.local.invoiceaudit",
    "productName": "发票审核台",
    "artifactName": "InvoiceAudit-${version}-${target}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "mail.js",
      "u8.js",
      "preload.js",
      "renderer/**/*",
      "!renderer/**/*.map",
      "!renderer/vendor/tesseract/core/*.wasm",
      "!renderer/vendor/tesseract/core/*-relaxedsimd*"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "InvoiceAudit-Portable-${version}.exe",
      "unicode": true
    },
    "nsis": {
      "artifactName": "InvoiceAudit-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "发票审核台",
      "unicode": true,
      "language": "2052"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DDF-git-hub",
        "repo": "invoice-audit",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DDF-git-hub/invoice-audit.git"
  }
}
